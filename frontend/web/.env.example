# Product URL used by Home, Products, and Product Detail pages.
# Set from .env based on each environment.
NEXT_PUBLIC_PRODUCT_URL=""

# API base URL used for product-service calls.
# Purchased products are fetched from {NEXT_API_BASE_URL}/purchased-products/{userId}.
NEXT_API_BASE_URL=""

# Cognito API endpoint and app client used by the custom frontend signup flow.
# Example endpoint: https://cognito-idp.ap-southeast-1.amazonaws.com/
NEXT_PUBLIC_COGNITO_API_ENDPOINT=""
NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID=""

# Browser localStorage key used by client auth session.
NEXT_PUBLIC_AUTH_STORAGE_KEY=""

# Optional manual override for static export builds.
# npm run export already triggers export mode automatically.
# NEXT_OUTPUT_MODE="export"
