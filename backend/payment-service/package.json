{
  "name": "payment-service",
  "version": "1.0.0",
  "private": true,
  "description": "Payment API Lambda service for KeJepangDulu",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('build',{recursive:true,force:true});require('fs').rmSync('lambda',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/syncBuildToLambda.js",
    "build:local": "npm run clean && tsc -p tsconfig.json",
    "start:local": "npm run build:local && node local-server.js"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1040.0",
    "@aws-sdk/lib-dynamodb": "3.1040.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.147",
    "@types/node": "^22.15.21",
    "typescript": "^5.8.3"
  }
}
