{
  "name": "payment-service",
  "version": "1.0.0",
  "private": true,
  "description": "Payment API Lambda service for KeJepangDulu",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('build',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "build:local": "npm run clean && tsc -p tsconfig.json",
    "start:local": "npm run build:local && node local-server.js",
    "test": "jest",
    "test:unit": "jest --runInBand"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1040.0",
    "@aws-sdk/lib-dynamodb": "3.1040.0",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.147",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.21",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.8.3"
  }
}
