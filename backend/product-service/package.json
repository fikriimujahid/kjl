{
  "name": "product-service",
  "version": "1.0.0",
  "private": true,
  "description": "Product API Lambda service for KeJepangDulu",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('build',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "start:local": "npm run build && node local-server.js",
    "seed:purchases": "node scripts/seedDummyPurchases.js"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1040.0",
    "@aws-sdk/client-s3": "3.1040.0",
    "@aws-sdk/lib-dynamodb": "3.1040.0",
    "@aws-sdk/s3-request-presigner": "3.1040.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.147",
    "@types/node": "^22.15.21",
    "typescript": "^5.8.3"
  }
}
